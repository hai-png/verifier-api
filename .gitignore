graphify-out/
.graphify*
*.db
package-lock.json
node_modules/
dist/
.env

# TypeScript incremental compilation output
*.tsbuildinfo

# Customer receipt uploads (multer destination).
uploads/

# loadtest-results/ was tracked until the load-test workflows were removed, and
# carried 5.8MB of superseded reports across 36 runs plus a server log containing
# request bodies and a 6-character API key prefix. It is now ignored, so a manual
# `node loadtest/run.mjs` run writes locally without being committed by accident.
# The findings are summarised in docs/loadtest-findings.md.
loadtest-results/

# Written by verify.php at runtime on the relay host: the provider's last
# known-good address, used to keep DNS off the request path. Machine state, not
# source, and it must never be committed.
.telebirr-upstream-ip

# Relay host runtime state: timestamped bad-period log written by verify.php
.telebirr-relay-events.log
