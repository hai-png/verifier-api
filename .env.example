# ─── Required ───────────────────────────────────────────────────────────────

# Database (MySQL — use TiDB Cloud Serverless free tier, or any MySQL 8.0+)
# TiDB: https://tidbcloud.com → Create Serverless cluster → Get connection string
DATABASE_URL=mysql://user:pass@host:4000/dbname?sslaccept=accept_invalid_certs

# Admin secret (for /admin/* endpoints — generate with: openssl rand -hex 32)
ADMIN_SECRET=change-me-to-a-random-string

# Dashboard secret (for dashboard-authenticated requests — generate with: openssl rand -hex 32)
DASHBOARD_SECRET=change-me-to-a-random-string

# ─── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated allow-list of browser origins permitted to call this API.
# UNSET MEANS SAME-ORIGIN ONLY — the correct default for a self-hosted deploy where
# the dashboard is served from the same host, and fail-closed everywhere else.
#
# Set this only if the dashboard is on a different domain, e.g.
#   CORS_ALLOWED_ORIGINS=https://verify.leul.et,https://www.example.com
#
# This replaces the previous `origin: true` behaviour, which reflected *any*
# Origin. Combined with CORS_CREDENTIALS that made every session-authenticated
# route readable and writable from any website.
CORS_ALLOWED_ORIGINS=

# REMOVED. CORS_CREDENTIALS is ignored and logs a warning at startup. The
# dashboard authenticates with `Authorization: Bearer <session token>`, which a
# cross-origin page cannot read. If you need cookie auth, that is an architecture
# change to this service, not an environment variable.

# ─── Client IP trust ─────────────────────────────────────────────────────────

# Whether to honour CF-Connecting-IP / X-Forwarded-For from a *public* peer.
#
# Default false. Forwarding headers are only trustworthy when the hop that set
# them is one you deployed; CF-Connecting-IP in particular is written by
# Cloudflare only for traffic that arrives through Cloudflare. Reached directly,
# it is the caller's — so trusting it let anyone mint a fresh rate-limit bucket per
# request by rotating one header, defeating the anonymous verification cap, the
# anonymous rate limiter, and the login/signup/confirm IP throttles.
#
# Set true ONLY when the origin is genuinely unreachable except through
# Cloudflare (enforced by firewall or platform setting, not by hope).
TRUST_FORWARDED_HEADERS=false

# How long a peer address is classified as trusted/untrusted. Default 60s.
# TRUSTED_PROXY_CACHE_MS=60000

# ─── Optional (features that need external services) ────────────────────────

# Redis (for BullMQ webhook/notification queues). If unset, queues are disabled
# and verifications still work — only webhook delivery + notifications break.
# Get free Redis: https://upstash.com → Create database
REDIS_URL=

# Mistral AI (for /verify-image OCR endpoint — required for image-based verification)
# Get a key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# ─── Telebirr proxy (required for Telebirr verification from non-Ethiopian IPs) ──
# Deploy verify.php on your Ethio Telecom Plesk hosting, then set these:
# FALLBACK_PROXIES may be the full URL up to ?reference=, or just the
# endpoint URL. The verifier adds reference and key safely in either form.
# e.g. https://proxy.noveld.com.et/verify.php?reference=
# List at least two, comma-separated. With only one, hedging, parallel racing,
# the pool deadline and the circuit breaker are all inert.
FALLBACK_PROXIES=
TELEBIRR_PROXY_KEY=
# Set to "true" if your server is NOT in Ethiopia (skip the direct fetch that will fail)
SKIP_PRIMARY_VERIFICATION=true
# Per-attempt relay budget. Keep it above the relay's own 11s budget and below
# TELEBIRR_TOTAL_TIMEOUT_MS, or the pool deadline can never fire.
# TELEBIRR_PROXY_TIMEOUT_MS=12000
# TELEBIRR_TOTAL_TIMEOUT_MS=20000

# ─── M-Pesa proxy (required for M-Pesa verification from non-Ethiopian IPs) ──
# Deploy mpesa.php on your Ethio Telecom Plesk hosting, then set these:
MPESA_FALLBACK_URL=https://proxy.noveld.com.et/mpesa.php
MPESA_PROXY_KEY=

# ─── Performance knobs (optional — defaults are tuned for a free-tier deploy) ─

# Merge identical verifications that arrive at the same time and replay a
# successful verification for this long (a completed receipt is immutable).
# 0 disables both. Failures are never cached.
VERIFY_CACHE_TTL_MS=60000
VERIFY_CACHE_MAX_ENTRIES=5000

# Usage logs and API key counters are buffered and written in batches. This is
# how often the buffer is flushed; a crash can lose up to this much analytics.
USAGE_LOG_FLUSH_MS=2000
KEY_USAGE_FLUSH_MS=5000

# The pricing row drives rate limits + monthly quotas and is read on every
# authenticated request, so it is cached briefly (invalidated on update).
BILLING_CONFIG_CACHE_TTL_MS=30000
# After the TTL, the cached row is still served for this long while it is
# refreshed in the background, so no request pays the cross-region read.
# Set to 0 to make an expired row block on a real read instead. Note this
# widens how long an admin pricing change takes to reach other instances,
# since the cache is per-process.
BILLING_CONFIG_STALE_MS=600000

# "This workspace has no webhooks/notification channels" is cached so ordinary
# verifications cost zero extra queries after the response.
WORKSPACE_DELIVERY_CACHE_TTL_MS=30000

# Legacy CBE verification drives headless Chromium; keep concurrency at 1 on a
# 512 MB instance. Queued requests are rejected after the timeout below.
CBE_MAX_CONCURRENT_BROWSER_OPS=1
CBE_BROWSER_QUEUE_TIMEOUT_MS=20000

# Close the headless Chromium after this long idle. It holds 150–300 MB once
# launched, so on a 512 MB instance it was pinned for the life of the deploy
# after a single legacy CBE verification. The next request pays the launch cost
# again, which is cheap because the path is rare.
CBE_BROWSER_IDLE_MS=120000

# Upper bound on distinct client IPs / API keys tracked by the in-memory rate
# limiter before the oldest windows are evicted.
#
# An evicted key keeps its count in a tombstone (a quarter of this many), so a
# caller cannot exhaust its own bucket by presenting many identities and starting
# again at zero. See src/utils/expiringStore.ts.
RATE_LIMIT_MAX_KEYS=20000

# Max JSON request body. multipart/form-data is bounded separately by the image
# upload limit in verifyImage.ts.
JSON_BODY_LIMIT=256kb

# Webhooks ───────────────────────────────────────────────────────────────────

# Emit the deprecated, replayable `X-Veritas-Legacy-Signature` header
# (HMAC over the body alone, no timestamp, valid forever).
#
# DEFAULT FALSE, deliberately. The timestamped `X-Veritas-Signature` exists
# precisely because a captured delivery must not be replayable; shipping both on
# every request gave every receiver the option of the replayable one with no
# removal date. Turn this on only for a receiver mid-migration, and give it a
# removal date rather than leaving it.
#
# The signature format is documented in README.md.
WEBHOOK_LEGACY_SIGNATURE=false

# ─── Queues ──────────────────────────────────────────────────────────────────

# Deadline on a single Redis operation (queue.add, getJobCounts). A stalled Redis
# previously hung the request that awaited it — including GET /ready, which meant
# Render never got its 503 and restarted a healthy instance instead of being told
# the service was degraded.
REDIS_OPERATION_TIMEOUT_MS=3000

# Hard ceiling on one outbound email / Telegram request. Both fetches previously
# carried no signal, and undici's bodyTimeout resets on every chunk, so a
# slow-dribbling endpoint could pin all five worker slots indefinitely.
NOTIFICATION_OUTBOUND_TIMEOUT_MS=10000

# ─── Limits and quotas ───────────────────────────────────────────────────────

# Workspaces one user may create. Each starts with 100 free verification credits,
# so an uncapped create route was a repeatable free-credit farm.
MAX_WORKSPACES_PER_USER=5

# ─── Logging ────────────────────────────────────────────────────────────────

# Log request bodies. Development only — it is IGNORED in production and logs a
# warning, because bodies contain buyer names, emails, phone numbers and receipt
# references. Credential-shaped fields inside a serialised body are redacted
# either way.
LOG_REQUEST_BODIES=false

# Write rotating files under logs/. Off by default on Render, where the platform
# already captures stdout and the container disk is ephemeral.
LOG_TO_FILES=true

# Skip `prisma db push` at container start (see Dockerfile). Set to true after
# the first successful deploy to cut cold-start time.
SKIP_SCHEMA_PUSH=false

# ─── App config ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Your deployment URL (used in error responses + upgrade links + password reset links)
VERITAS_APP_URL=https://verify.noveld.com.et

# ─── Password reset emails (optional) ────────────────────────────────────────
# If unset, POST /auth/forgot-password still responds 200 but no email is sent;
# use POST /admin/password-reset-link (x-admin-key) to issue links manually.
# Get a key: https://resend.com → API Keys. The from address must be on a
# domain verified in Resend.
RESEND_API_KEY=
VERITAS_NOTIFICATIONS_FROM_EMAIL=noreply@noveld.com.et

# ─── Amount check basis (optional) ───────────────────────────────────────────
# What `expectedAmount` is compared against. Default: net.
#
# net    - what the recipient's account actually received, after the provider's
#          service fee. This is what a merchant reconciles against a bank
#          statement. Telebirr, CBE and Zemen report a settled/credited figure
#          directly; for the others it is derived as charged minus the fee the
#          provider itself reported.
# gross  - what the payer was charged, before the fee.
#
# They differ by real money. One observed Telebirr transaction: the sender was
# debited 801 Birr (service fee 3.48 + VAT 0.52) and 797 Birr was credited.
# Expecting 797 and comparing against 801 rejects a correct payment; expecting
# 801 and comparing against 797 approves a short one.
#
# Fee rates are never hardcoded — they change, they are tiered by amount, and
# some transactions are fee-free. The provider's own reported figure is always
# used, so no rate is baked in here.
#
# Set to gross only if your pricing genuinely works from the charged amount.
VERIFY_AMOUNT_BASIS=net

# ─── Status monitor (optional — for internal health probes) ─────────────────
STATUS_MONITOR_SECRET=
STATUS_PROBE_TELEBIRR_REFERENCE=
STATUS_PROBE_CBE_LEGACY_REFERENCE=
STATUS_PROBE_CBE_LEGACY_ACCOUNT_SUFFIX=
STATUS_PROBE_CBE_NEW_URL=
STATUS_PROBE_CBEBIRR_REFERENCE=
STATUS_PROBE_CBEBIRR_PHONE=
STATUS_PROBE_DASHEN_REFERENCE=
STATUS_PROBE_ABYSSINIA_REFERENCE=
STATUS_PROBE_ABYSSINIA_ACCOUNT_SUFFIX=

# How long a request waits for the runtime during a cold start before it is
# answered with 503 + Retry-After (default 15000). Raise it only if your
# platform's first request legitimately needs longer than that.
# STARTUP_WAIT_MS=15000

# The in-process keep-alive pinger keeps the Render instance (and TiDB) from
# idling out by hitting the public URL every 5 minutes. Set to false when an
# external monitor does the pinging, or when measuring a real cold start.
# KEEP_ALIVE_PINGER=true

# Verification result cache: identical single-reference verifications within the
# TTL reuse one provider call (positive results only — failures are never
# cached) and concurrent duplicates are coalesced. Set to 0 to disable and
# always hit the provider. Responses carry x-verify-cache: hit|coalesced.
# VERIFY_CACHE_TTL_MS=60000
# VERIFY_CACHE_MAX_ENTRIES=5000

# Unified single-receipt pipeline: cache only successful/final provider results
# per workspace, after fresh authorization/rate/quota checks. Cache hits are
# billable as before; set VERIFY_CACHE_TTL_MS=0 for fresh-provider lab tests.
VERIFY_CACHE_MAX_INFLIGHT=128
# Dashen: total wall-clock network retry budget (1..120000 ms), at most 2 attempts.
# Permanent 4xx outcomes are never retried; transient retry delay is 250 ms.
DASHEN_TOTAL_TIMEOUT_MS=15000
