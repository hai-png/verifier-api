# ─── Required ───────────────────────────────────────────────────────────────

# Database (MySQL — use TiDB Cloud Serverless free tier, or any MySQL 8.0+)
# TiDB: https://tidbcloud.com → Create Serverless cluster → Get connection string
DATABASE_URL=mysql://user:pass@host:4000/dbname?sslaccept=accept_invalid_certs

# Admin secret (for /admin/* endpoints — generate with: openssl rand -hex 32)
ADMIN_SECRET=change-me-to-a-random-string

# Dashboard secret (for dashboard-authenticated requests — generate with: openssl rand -hex 32)
DASHBOARD_SECRET=change-me-to-a-random-string

# ─── Optional (features that need external services) ────────────────────────

# Redis (for BullMQ webhook/notification queues). If unset, queues are disabled
# and verifications still work — only webhook delivery + notifications break.
# Get free Redis: https://upstash.com → Create database
REDIS_URL=

# Mistral AI (for /verify-image OCR endpoint — required for image-based verification)
# Get a key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# ─── Telebirr proxy (required for Telebirr verification from non-Ethiopian IPs) ──
# Deploy verify.php on your Ethio Telecom Plesk hosting, then set these:
# FALLBACK_PROXIES should be the full URL up to (and including) ?reference=
# e.g. https://proxy.noveld.com.et/verify.php?reference=
FALLBACK_PROXIES=
TELEBIRR_PROXY_KEY=
# Set to "true" if your server is NOT in Ethiopia (skip the direct fetch that will fail)
SKIP_PRIMARY_VERIFICATION=true

# ─── M-Pesa proxy (required for M-Pesa verification from non-Ethiopian IPs) ──
# Deploy mpesa.php on your Ethio Telecom Plesk hosting, then set these:
MPESA_FALLBACK_URL=https://proxy.noveld.com.et/mpesa.php
MPESA_PROXY_KEY=

# ─── App config ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Your deployment URL (used in error responses + upgrade links)
VERITAS_APP_URL=https://verify.noveld.com.et

# ─── Status monitor (optional — for internal health probes) ─────────────────
STATUS_MONITOR_SECRET=
STATUS_PROBE_TELEBIRR_REFERENCE=
STATUS_PROBE_CBE_LEGACY_REFERENCE=
STATUS_PROBE_CBE_LEGACY_ACCOUNT_SUFFIX=
STATUS_PROBE_CBE_NEW_URL=
STATUS_PROBE_CBEBIRR_REFERENCE=
STATUS_PROBE_CBEBIRR_PHONE=
STATUS_PROBE_DASHEN_REFERENCE=
STATUS_PROBE_ABYSSINIA_REFERENCE=
STATUS_PROBE_ABYSSINIA_ACCOUNT_SUFFIX=
