# ─── Required ───────────────────────────────────────────────────────────────

# Database (MySQL — use TiDB Cloud Serverless free tier, or any MySQL 8.0+)
# TiDB: https://tidbcloud.com → Create Serverless cluster → Get connection string
DATABASE_URL=mysql://user:pass@host:4000/dbname?sslaccept=accept_invalid_certs

# Admin secret (for /admin/* endpoints — generate with: openssl rand -hex 32)
ADMIN_SECRET=change-me-to-a-random-string

# Dashboard secret (for dashboard-authenticated requests — generate with: openssl rand -hex 32)
DASHBOARD_SECRET=change-me-to-a-random-string

# ─── Optional (features that need external services) ────────────────────────

# Redis (for BullMQ webhook/notification queues). If unset, queues are disabled
# and verifications still work — only webhook delivery + notifications break.
# Get free Redis: https://upstash.com → Create database
REDIS_URL=

# Mistral AI (for /verify-image OCR endpoint — required for image-based verification)
# Get a key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# ─── Telebirr proxy (required for Telebirr verification from non-Ethiopian IPs) ──
# Deploy verify.php on your Ethio Telecom Plesk hosting, then set these:
# FALLBACK_PROXIES may be the full URL up to ?reference=, or just the
# endpoint URL. The verifier adds reference and key safely in either form.
# e.g. https://proxy.noveld.com.et/verify.php?reference=
FALLBACK_PROXIES=
TELEBIRR_PROXY_KEY=
# Set to "true" if your server is NOT in Ethiopia (skip the direct fetch that will fail)
SKIP_PRIMARY_VERIFICATION=true

# ─── M-Pesa proxy (required for M-Pesa verification from non-Ethiopian IPs) ──
# Deploy mpesa.php on your Ethio Telecom Plesk hosting, then set these:
MPESA_FALLBACK_URL=https://proxy.noveld.com.et/mpesa.php
MPESA_PROXY_KEY=

# ─── Performance knobs (optional — defaults are tuned for a free-tier deploy) ─

# Merge identical verifications that arrive at the same time and replay a
# successful verification for this long (a completed receipt is immutable).
# 0 disables both. Failures are never cached.
VERIFY_CACHE_TTL_MS=60000
VERIFY_CACHE_MAX_ENTRIES=5000

# Usage logs and API key counters are buffered and written in batches. This is
# how often the buffer is flushed; a crash can lose up to this much analytics.
USAGE_LOG_FLUSH_MS=2000
KEY_USAGE_FLUSH_MS=5000

# The pricing row drives rate limits + monthly quotas and is read on every
# authenticated request, so it is cached briefly (invalidated on update).
BILLING_CONFIG_CACHE_TTL_MS=30000

# "This workspace has no webhooks/notification channels" is cached so ordinary
# verifications cost zero extra queries after the response.
WORKSPACE_DELIVERY_CACHE_TTL_MS=30000

# Legacy CBE verification drives headless Chromium; keep concurrency at 1 on a
# 512 MB instance. Queued requests are rejected after the timeout below.
CBE_MAX_CONCURRENT_BROWSER_OPS=1
CBE_BROWSER_QUEUE_TIMEOUT_MS=20000

# Upper bound on distinct client IPs / API keys tracked by the in-memory rate
# limiter before the oldest windows are evicted.
RATE_LIMIT_MAX_KEYS=20000

# Skip `prisma db push` at container start (see Dockerfile). Set to true after
# the first successful deploy to cut cold-start time.
SKIP_SCHEMA_PUSH=false

# ─── App config ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Your deployment URL (used in error responses + upgrade links + password reset links)
VERITAS_APP_URL=https://verify.noveld.com.et

# ─── Password reset emails (optional) ────────────────────────────────────────
# If unset, POST /auth/forgot-password still responds 200 but no email is sent;
# use POST /admin/password-reset-link (x-admin-key) to issue links manually.
# Get a key: https://resend.com → API Keys. The from address must be on a
# domain verified in Resend.
RESEND_API_KEY=
VERITAS_NOTIFICATIONS_FROM_EMAIL=noreply@noveld.com.et

# ─── Status monitor (optional — for internal health probes) ─────────────────
STATUS_MONITOR_SECRET=
STATUS_PROBE_TELEBIRR_REFERENCE=
STATUS_PROBE_CBE_LEGACY_REFERENCE=
STATUS_PROBE_CBE_LEGACY_ACCOUNT_SUFFIX=
STATUS_PROBE_CBE_NEW_URL=
STATUS_PROBE_CBEBIRR_REFERENCE=
STATUS_PROBE_CBEBIRR_PHONE=
STATUS_PROBE_DASHEN_REFERENCE=
STATUS_PROBE_ABYSSINIA_REFERENCE=
STATUS_PROBE_ABYSSINIA_ACCOUNT_SUFFIX=

# How long a request waits for the runtime during a cold start before it is
# answered with 503 + Retry-After (default 15000). Raise it only if your
# platform's first request legitimately needs longer than that.
# STARTUP_WAIT_MS=15000

# The in-process keep-alive pinger keeps the Render instance (and TiDB) from
# idling out by hitting the public URL every 5 minutes. Set to false when an
# external monitor does the pinging, or when measuring a real cold start.
# KEEP_ALIVE_PINGER=true

# Unified single-receipt pipeline: cache only successful/final provider results
# per workspace, after fresh authorization/rate/quota checks. Cache hits are
# billable as before; set VERIFY_CACHE_TTL_MS=0 for fresh-provider lab tests.
# (VERIFY_CACHE_TTL_MS and VERIFY_CACHE_MAX_ENTRIES are documented once, under
# "Performance knobs" above — they were listed twice here with different values.)
VERIFY_CACHE_MAX_INFLIGHT=128
# Dashen: total wall-clock network retry budget (1..120000 ms), at most 2 attempts.
# Permanent 4xx outcomes are never retried; transient retry delay is 250 ms.
DASHEN_TOTAL_TIMEOUT_MS=15000

# ─── Security posture ────────────────────────────────────────────────────────
# Each of these controls a decision that used to be hardcoded in source. All are
# reported on GET /status/summary (with x-status-secret) and logged at startup, so
# the running posture is visible without reading the code.

# TLS certificate verification for provider fetches. Verification is ON for every
# host except the ones listed here. These four are seeded because their chains
# genuinely do not validate today — remove a host the moment it does, and the
# change needs no deploy of code.
#   apps.cbe.com.et, mb.cbe.com.et, awashpay.awashbank.com, share.zemenbank.com
# Set to an empty value to verify every host.
#INSECURE_TLS_HOSTS=apps.cbe.com.et,mb.cbe.com.et,awashpay.awashbank.com,share.zemenbank.com

# PEM bundle for hosts whose chain is valid but whose root CA is missing from the
# container (the curl errno 60 case documented in verify.php). Preferred over
# relaxing verification: this keeps the connection authenticated.
#TLS_CA_BUNDLE_PATH=/etc/ssl/certs/ethiopian-roots.pem

# Encrypts Webhook.signingSecret at rest (AES-256-GCM). Without it, secrets are
# stored in plaintext and a database read yields the signing key for every
# merchant webhook — enough to forge deliveries they would accept. Existing
# plaintext rows are re-encrypted automatically at startup once this is set.
# Generate with: openssl rand -hex 32
#WEBHOOK_SECRET_KEY=

# Set by Cloudflare when the request really came through their edge. Used to
# corroborate CF-Connecting-IP before an IP-based rate limit trusts it; without
# this, a client that can reach the origin directly can forge the header and get
# a fresh rate-limit bucket per request. Create it in Cloudflare under
# Rules → Settings → Authenticated Origin Pulls / ingress secret.
#CLOUDFLARE_INGRESS_SECRET=

# Which header getClientIp should believe. 'auto' (default) prefers
# CF-Connecting-IP, then the rightmost X-Forwarded-For entry, then the TCP peer.
# Pin it to 'cf-connecting-ip' or 'x-forwarded-for' behind a known proxy, or to
# 'socket' to ignore proxy headers entirely — the right setting when the app is
# reachable directly, because then any client can write those headers itself and
# get a fresh rate-limit bucket per request.
#CLIENT_IP_SOURCE=auto

# /verify-image reads a picture of a receipt with a vision model. For banks with
# no public API, nothing can confirm the payment actually happened — a forged
# image is indistinguishable from a real receipt. The response therefore reports
# verified:false and describes what was read. Set this to true (or pass
# ?trustOcr=true per request) to restore the legacy verified:true shorthand; every
# such call is logged. Better: pass expectedAmount / expectedPayerName /
# expectedPayerPhone and have them compared server-side.
#OCR_TRUST_IMAGES=false

# ─── Maintenance & bounds (optional) ─────────────────────────────────────────

# How often lapsed sessions and never-used password-reset tokens are deleted, and
# the most rows one sweep will remove. Without this the Session table grows with
# every login the service has ever had.
#SESSION_SWEEP_INTERVAL_MS=21600000
#SESSION_SWEEP_BATCH=5000

# Caps on the in-memory per-endpoint / per-IP stats maps, and on how many groups
# an admin stats call or the startup aggregation may load from UsageLog. Both
# queries GROUP BY the whole table; unbounded, they grow with traffic and can OOM
# a 512 MB instance during boot.
#STATS_MAX_KEYS=5000
#STATS_RESPONSE_LIMIT=200

# Set the raw body/query of every request into the log. This middleware runs
# BEFORE authentication, so a login body carries a plaintext password and a query
# string can carry ?adminKey=. Local debugging only — never enable in production.
#LOG_REQUEST_BODIES=false

# Relay-side (mpesa.php / verify.php on your Plesk host), not read by the API:
#   MPESA_PROXY_DEBUG=true   answer with the cURL diagnostic trace instead of the
#                            receipt. Server-side only — it used to be a public
#                            ?debug=true flag on an authenticated relay.
#   MPESA_PROXY_CAINFO=/path/to/cacert.pem   CA bundle for the relay's cURL.
