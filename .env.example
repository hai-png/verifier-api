# ─── Required ───────────────────────────────────────────────────────────────

# Database (MySQL — use TiDB Cloud Serverless free tier, or any MySQL 8.0+)
# TiDB: https://tidbcloud.com → Create Serverless cluster → Get connection string
DATABASE_URL=mysql://user:pass@host:4000/dbname?sslaccept=accept_invalid_certs

# Admin secret (for /admin/* endpoints — generate with: openssl rand -hex 32)
ADMIN_SECRET=change-me-to-a-random-string

# Dashboard secret (for dashboard-authenticated requests — generate with: openssl rand -hex 32)
DASHBOARD_SECRET=change-me-to-a-random-string

# ─── Optional (features that need external services) ────────────────────────

# Redis (for BullMQ webhook/notification queues). If unset, queues are disabled
# and verifications still work — only webhook delivery + notifications break.
# Get free Redis: https://upstash.com → Create database
REDIS_URL=

# Mistral AI (for /verify-image OCR endpoint — required for image-based verification)
# Get a key: https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# ─── Telebirr proxy (required for Telebirr verification from non-Ethiopian IPs) ──
# Deploy verify.php on your Ethio Telecom Plesk hosting, then set these:
# FALLBACK_PROXIES may be the full URL up to ?reference=, or just the
# endpoint URL. The verifier adds reference and key safely in either form.
# e.g. https://proxy.noveld.com.et/verify.php?reference=
FALLBACK_PROXIES=
TELEBIRR_PROXY_KEY=
# Set to "true" if your server is NOT in Ethiopia (skip the direct fetch that will fail)
SKIP_PRIMARY_VERIFICATION=true

# ─── M-Pesa proxy (required for M-Pesa verification from non-Ethiopian IPs) ──
# Deploy mpesa.php on your Ethio Telecom Plesk hosting, then set these:
MPESA_FALLBACK_URL=https://proxy.noveld.com.et/mpesa.php
MPESA_PROXY_KEY=

# ─── Performance knobs (optional — defaults are tuned for a free-tier deploy) ─

# Merge identical verifications that arrive at the same time and replay a
# successful verification for this long (a completed receipt is immutable).
# 0 disables both. Failures are never cached.
VERIFY_CACHE_TTL_MS=60000
VERIFY_CACHE_MAX_ENTRIES=5000

# Usage logs and API key counters are buffered and written in batches. This is
# how often the buffer is flushed; a crash can lose up to this much analytics.
USAGE_LOG_FLUSH_MS=2000
KEY_USAGE_FLUSH_MS=5000

# The pricing row drives rate limits + monthly quotas and is read on every
# authenticated request, so it is cached briefly (invalidated on update).
BILLING_CONFIG_CACHE_TTL_MS=30000

# "This workspace has no webhooks/notification channels" is cached so ordinary
# verifications cost zero extra queries after the response.
WORKSPACE_DELIVERY_CACHE_TTL_MS=30000

# Legacy CBE verification drives headless Chromium; keep concurrency at 1 on a
# 512 MB instance. Queued requests are rejected after the timeout below.
CBE_MAX_CONCURRENT_BROWSER_OPS=1
CBE_BROWSER_QUEUE_TIMEOUT_MS=20000

# Upper bound on distinct client IPs / API keys tracked by the in-memory rate
# limiter before the oldest windows are evicted.
RATE_LIMIT_MAX_KEYS=20000

# Skip `prisma db push` at container start (see Dockerfile). Set to true after
# the first successful deploy to cut cold-start time.
SKIP_SCHEMA_PUSH=false

# ─── App config ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# Your deployment URL (used in error responses + upgrade links + password reset links)
VERITAS_APP_URL=https://verify.noveld.com.et

# ─── Password reset emails (optional) ────────────────────────────────────────
# If unset, POST /auth/forgot-password still responds 200 but no email is sent;
# use POST /admin/password-reset-link (x-admin-key) to issue links manually.
# Get a key: https://resend.com → API Keys. The from address must be on a
# domain verified in Resend.
RESEND_API_KEY=
VERITAS_NOTIFICATIONS_FROM_EMAIL=noreply@noveld.com.et

# ─── Status monitor (optional — for internal health probes) ─────────────────
STATUS_MONITOR_SECRET=
STATUS_PROBE_TELEBIRR_REFERENCE=
STATUS_PROBE_CBE_LEGACY_REFERENCE=
STATUS_PROBE_CBE_LEGACY_ACCOUNT_SUFFIX=
STATUS_PROBE_CBE_NEW_URL=
STATUS_PROBE_CBEBIRR_REFERENCE=
STATUS_PROBE_CBEBIRR_PHONE=
STATUS_PROBE_DASHEN_REFERENCE=
STATUS_PROBE_ABYSSINIA_REFERENCE=
STATUS_PROBE_ABYSSINIA_ACCOUNT_SUFFIX=

# How long a request waits for the runtime during a cold start before it is
# answered with 503 + Retry-After (default 15000). Raise it only if your
# platform's first request legitimately needs longer than that.
# STARTUP_WAIT_MS=15000

# The in-process keep-alive pinger keeps the Render instance (and TiDB) from
# idling out by hitting the public URL every 5 minutes. Set to false when an
# external monitor does the pinging, or when measuring a real cold start.
# KEEP_ALIVE_PINGER=true
