# Base URL of the verifier-api (Render). Bake into the static build.
NEXT_PUBLIC_API_URL=https://verifier-api-selfhosted.onrender.com

# Where the API sends users in password-reset emails (this dashboard's URL).
# Must match VERITAS_APP_URL in the API's environment.
# NEXT_PUBLIC_APP_URL=https://dashboard.noveld.com.et

# Telegram bot username for the "Continue with Telegram" button on the sign-in
# page (the official Login Widget). Must be the SAME bot whose token the API
# holds in TELEGRAM_BOT_TOKEN, or the widget's signatures will not verify.
# Unset -> the button is hidden and the page shows email/password only.
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=NoveldBot
