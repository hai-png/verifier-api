# REQUIRED. Absolute base URL of *your* verifier-api deployment. Baked into the
# static bundle at build time — changing it means rebuilding the dashboard.
#
# There is deliberately no default in the code. It used to fall back to one
# specific third-party Render host, which on a self-hosted deployment meant login
# credentials, bearer tokens and verification API keys were posted to a server
# nobody reading this file controls. Unset now means "this origin", which fails
# visibly instead of silently succeeding against someone else's.
NEXT_PUBLIC_API_URL=https://your-verifier-api.example.com

# Where the API sends users in password-reset emails (this dashboard's URL).
# Must match VERITAS_APP_URL in the API's environment.
# NEXT_PUBLIC_APP_URL=https://dashboard.noveld.com.et
