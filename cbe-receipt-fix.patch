                 const buffer = validatePdfBuffer(
                     navigationBuffer,
@@ -306,13 +337,16 @@ async function fetchCBEReceiptWithPuppeteer(fullId: string): Promise<ArrayBuffer
 
         const pdfResponse = await pdfResponsePromise;
         if (pdfResponse) {
