-            if (isPdfBuffer(buffer)) {
-                return buffer.buffer.slice(
-                    buffer.byteOffset,
-                    buffer.byteOffset + buffer.byteLength
-                ) as ArrayBuffer;
-            }
+            const buffer = validatePdfBuffer(
+                await pdfResponse.buffer(),
