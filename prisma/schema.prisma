// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?
    // Added for self-hosted email/password auth (not part of NextAuth spec)
    passwordHash             String? @db.Text

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    role          Role      @default(USER)
    createdAt     DateTime  @default(now())

    currentWorkspaceId String?
    memberships        Membership[]
    sentInvitations    Invitation[] @relation("InvitationSender")
    betaAccessRequests BetaAccessRequest[] @relation("BetaAccessRequester")
    betaAccessReviews  BetaAccessRequest[] @relation("BetaAccessReviewer")
}

// ─── Workspaces ───────────────────────────────────────────────────────────────

model Workspace {
    id        String   @id @default(cuid())
    name      String
    createdAt DateTime @default(now())

    tier                       ApiTier   @default(FREE)
    verificationCredits        Int       @default(0)
    verificationCreditsMonthly Int       @default(0)
    verificationCreditsResetAt DateTime?
    paidUntil                  DateTime?
    planTermMonths             Int?
    imageCredits               Int       @default(0)
    imageCreditsMonthly        Int       @default(0)
    imageCreditsResetAt        DateTime?
    grandfathered              Boolean   @default(false)

    // Admin-granted "never runs out", set per workspace rather than per plan.
    //
    // Deliberately a boolean and not a large number in the credit columns: the
    // monthly reset overwrites imageCredits with the plan allotment, and an
    // expired plan downgrades the workspace and does the same, so a sentinel
    // like 999999 would be silently wiped every 30 days. A flag is untouched by
    // both paths, so an unlimited grant persists the way a deliberate admin
    // decision should.
    //
    // It also means the credits are not merely set very high — the gates and the
    // decrements are skipped outright, so there is no counter to exhaust and no
    // balance left to read as a real number in an API response.
        verificationCreditsUnlimited Boolean @default(false)
    imageCreditsUnlimited        Boolean @default(false)

    // Every verification this workspace has been shown, so a receipt that has
    // already been used can be recognised when it comes round again. The result
    // cache cannot do this: it is in memory, expires in 60s, and is not shared
    // across instances.
    verifiedTransactions VerifiedTransaction[]

    memberships          Membership[]
    invitations          Invitation[]
    apiKeys              ApiKey[]
    webhooks             Webhook[]
    notificationChannels NotificationChannel[]
    payoutAccounts       PayoutAccount[]
    products             Product[]
    paymentLinks         PaymentLink[]
    orders               Order[]
    billingPayments      BillingPayment[]
    betaAccessRequest    BetaAccessRequest?
}

enum WorkspaceRole {
    OWNER
    ADMIN
    MEMBER
}

model Membership {
    id          String        @id @default(cuid())
    userId      String
    user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    workspaceId String
    workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    role        WorkspaceRole @default(MEMBER)
    createdAt   DateTime      @default(now())

    @@unique([userId, workspaceId])
    @@index([workspaceId])
}

enum InvitationStatus {
    PENDING
    ACCEPTED
    REVOKED
    EXPIRED
}

model Invitation {
    id              String           @id @default(cuid())
    workspaceId     String
    workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    invitedByUserId String
    invitedBy       User             @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
    email           String
    role            WorkspaceRole    @default(MEMBER)
    status          InvitationStatus @default(PENDING)
    token           String           @unique
    expiresAt       DateTime
    createdAt       DateTime         @default(now())
    acceptedAt      DateTime?

    @@index([workspaceId])
    @@index([email])
}

enum Role {
    USER
    ADMIN
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

enum ApiTier {
    FREE
    PRO
    BUSINESS
}

model ApiKey {
    id           String        @id @default(uuid())
    key          String?       @unique
    keyHash      String?       @unique
    prefix       String?
    workspaceId  String
    workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    createdAt    DateTime      @default(now())
    lastUsed     DateTime?
    usageCount   Int           @default(0)
    isActive     Boolean       @default(true)
    UsageLog     UsageLog[]
permissions  Json          @default("[\"verify\"]")
  paymentLinks PaymentLink[]

  // The account this key's verifications are checked against when a request does
  // not name one. A merchant integration normally collects into a single account,
  // so binding it once beats making every caller pass an id forever. A request may
  // still override it for a one-off.
  //
  // onDelete SetNull, so retiring a payout account disables the check rather than
  // deleting the key that depends on it.
  defaultPayoutAccountId String?
  defaultPayoutAccount   PayoutAccount? @relation("ApiKeyDefaultPayoutAccount", fields: [defaultPayoutAccountId], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([workspaceId])
  @@index([defaultPayoutAccountId])
}

model UsageLog {
    id           Int      @id @default(autoincrement())
    apiKeyId     String
    apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id])
    endpoint     String
    method       String
    statusCode   Int
    responseTime Int
    ip           String
    createdAt    DateTime @default(now())

    @@index([apiKeyId])
    @@index([endpoint])
    @@index([createdAt])
    // The status page groups usage by client IP, which was a full table scan
    // (98ms and climbing with row count) because ip carried no index.
    @@index([ip])
}

// Account-owned webhook. Every webhook in a workspace fires for every matching
// event in that workspace, regardless of which credential triggered it.
// Stripe/Linear/GitHub-style routing.
model Webhook {
    id            String            @id @default(cuid())
    workspaceId   String
    workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    url           String
    events        Json
    active        Boolean           @default(true)
    // Raw signing secret used to compute X-Veritas-Signature.
    // Column mapped to legacy `secretHash` for backward compat.
    signingSecret String?           @map("secretHash")
    createdAt     DateTime          @default(now())
    deliveries    WebhookDelivery[]

    @@index([workspaceId])
}

model WebhookDelivery {
    id                  String                @id @default(cuid())
    webhookId           String
    webhook             Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
    event               String                @default("unknown")
    payload             Json
    statusCode          Int?
    success             Boolean               @default(false)
    status              WebhookDeliveryStatus @default(QUEUED)
    attempts            Int                   @default(0)
    maxAttempts         Int                   @default(4)
    lastError           String?               @db.Text
    responseBody        String?               @db.Text
    queueJobId          String?
    nextRetryAt         DateTime?
    deliveredAt         DateTime?
    replayOfDeliveryId  String?
    replayOfDelivery    WebhookDelivery?      @relation("WebhookDeliveryReplay", fields: [replayOfDeliveryId], references: [id], onDelete: SetNull)
    replays             WebhookDelivery[]     @relation("WebhookDeliveryReplay")
    resolvedByReplayId  String?
    resolvedByReplay    WebhookDelivery?      @relation("WebhookDeliveryResolution", fields: [resolvedByReplayId], references: [id], onDelete: SetNull)
    resolvedDeadLetters WebhookDelivery[]     @relation("WebhookDeliveryResolution")
    resolvedAt          DateTime?
    createdAt           DateTime              @default(now())
    updatedAt           DateTime              @default(now()) @updatedAt

    @@index([webhookId])
    @@index([webhookId, status])
    @@index([replayOfDeliveryId])
    @@index([resolvedByReplayId])
}

enum WebhookDeliveryStatus {
    QUEUED
    PROCESSING
    RETRYING
    SUCCEEDED
    DEAD_LETTER
    CANCELLED
}

model NotificationChannel {
    id          String                  @id @default(cuid())
    workspaceId String
    workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    type        NotificationChannelType
    label       String?
    destination String
    events      Json
    active      Boolean                 @default(true)
    createdAt   DateTime                @default(now())
    updatedAt   DateTime                @default(now()) @updatedAt
    deliveries  NotificationDelivery[]

    @@index([workspaceId])
    @@index([workspaceId, type])
}

model NotificationDelivery {
    id           String                     @id @default(cuid())
    channelId    String
    channel      NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
    event        String
    payload      Json
    success      Boolean                    @default(false)
    status       NotificationDeliveryStatus @default(QUEUED)
    attempts     Int                        @default(0)
    maxAttempts  Int                        @default(4)
    lastError    String?                    @db.Text
    responseBody String?                    @db.Text
    queueJobId   String?
    nextRetryAt  DateTime?
    deliveredAt  DateTime?
    createdAt    DateTime                   @default(now())
    updatedAt    DateTime                   @default(now()) @updatedAt

    @@index([channelId])
    @@index([channelId, status])
}

enum NotificationChannelType {
    EMAIL
    TELEGRAM
}

enum NotificationDeliveryStatus {
    QUEUED
    PROCESSING
    RETRYING
    SUCCEEDED
    DEAD_LETTER
    CANCELLED
}

model PaymentLink {
    id                  String             @id @default(cuid())
    workspaceId         String
    workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    productId           String?
    product             Product?           @relation(fields: [productId], references: [id], onDelete: Cascade)
    createdByKeyId      String?            @map("apiKeyId")
    createdByKey        ApiKey?            @relation(fields: [createdByKeyId], references: [id])
    creatorType         PaymentLinkCreator @default(API_KEY)
    name                String
    mode                PaymentLinkMode
    fixedAmount         Float
    acceptedProviders   Json               @default("[]")
    redirectUrl         String?
    status              PaymentLinkStatus  @default(ACTIVE)
    isDefaultForProduct Boolean            @default(false)
    createdAt           DateTime           @default(now())
    expiresAt           DateTime?
    payoutAccounts      PayoutAccount[]    @relation("PaymentLinkPayoutAccounts")
    orders              Order[]

    @@index([workspaceId])
    @@index([productId])
    @@index([createdByKeyId])
    @@index([status])
    @@index([isDefaultForProduct])
}

enum PaymentLinkStatus {
    ACTIVE
    INACTIVE
    EXPIRED
}

enum PaymentLinkMode {
    PRODUCT
    CUSTOM
}

enum PaymentLinkCreator {
    DASHBOARD
    API_KEY
}

// ─── Payout accounts ─────────────────────────────────────────────────────────
// Saved destinations where the merchant's payments land. Reusable across
// CheckoutSessions and Products. When verifying, the system finds the user's
// active PayoutAccount whose `providersAllowed` includes the provider the
// buyer paid through, and matches against its `account`.

enum PayoutAccountType {
    PHONE
    BANK
}

model PayoutAccount {
    id                String            @id @default(cuid())
    workspaceId       String
    workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    label             String
    accountHolderName String?
    type              PayoutAccountType
    account           String
    providersAllowed  Json              @default("[]")
    isDefault         Boolean           @default(false)
    active            Boolean           @default(true)
    createdAt         DateTime          @default(now())
    products          Product[]         @relation("ProductPayoutAccounts")
    paymentLinks      PaymentLink[]     @relation("PaymentLinkPayoutAccounts")
    defaultForApiKeys ApiKey[]          @relation("ApiKeyDefaultPayoutAccount")

    @@index([workspaceId])
}

// ─── Products & Orders ───────────────────────────────────────────────────────

model Product {
    id          String    @id @default(cuid())
    workspaceId String
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    name        String
    description String? @db.Text
    imageUrl    String?
    price       Float

    acceptedProviders Json    @default("[]")
    maxBuyers         Int?
    /// Confirmed sales, claimed atomically so concurrent confirmations cannot
    /// oversell. Counted orders was a read-then-write: two buyers arriving at
    /// once both read the same "one slot left" and both won. Only
    /// paymentLinks.ts creates orders, so this stays in step with them.
    soldCount         Int     @default(0)
    active            Boolean @default(true)

    successMessage String? @db.Text
    deliveryUrl    String?

    createdAt      DateTime        @default(now())
    payoutAccounts PayoutAccount[] @relation("ProductPayoutAccounts")
    paymentLinks   PaymentLink[]
    orders         Order[]

    @@index([workspaceId])
}

model Order {
    id            String      @id @default(cuid())
    paymentLinkId String
    paymentLink   PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
    productId     String?
    product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
    workspaceId   String
    workspace     Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    buyerName     String?
    buyerPhone    String?
    buyerEmail    String?
    reference     String      @unique
    provider      String
    amountPaid    Float
    payoutAccount String
    status        OrderStatus @default(PAID)
    createdAt     DateTime    @default(now())

    @@index([paymentLinkId])
    @@index([productId])
    @@index([workspaceId])
}

enum OrderStatus {
    PAID
    REFUNDED
}

model PlanPricingConfig {
    id                               String   @id @default("default")
    proPriceMonthlyETB               Int
    businessPriceMonthlyETB          Int
    discount3MonthsPercent           Int      @default(10)
    discount6MonthsPercent           Int      @default(18)
    discount12MonthsPercent          Int      @default(30)
    freeQuotaNewMonthly              Int      @default(100)
    freeQuotaLegacyMonthly           Int      @default(250)
    proQuotaMonthly                  Int      @default(2000)
    businessQuotaMonthly             Int      @default(50000)
    freeRateLimit                    Int      @default(10)
    proRateLimit                     Int      @default(60)
    businessRateLimit                Int      @default(300)
    freeImageCredits                 Int      @default(0)
    proImageCredits                  Int      @default(100)
    businessImageCredits             Int      @default(300)
    freeBatchMaxReferences           Int      @default(0)
    proBatchMaxReferences            Int      @default(20)
    businessBatchMaxReferences       Int      @default(100)
    freeWebhookLimit                 Int      @default(0)
    proWebhookLimit                  Int      @default(20)
    businessWebhookLimit             Int      @default(50)
    freeNotificationChannelLimit     Int      @default(0)
    proNotificationChannelLimit      Int      @default(0)
    businessNotificationChannelLimit Int      @default(20)
    businessUnlimitedVerifications   Boolean  @default(false)
    createdAt                        DateTime @default(now())
    updatedAt                        DateTime @updatedAt
}

model BillingPayment {
    id                         String    @id @default(cuid())
    workspaceId                String
    workspace                  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    reference                  String    @unique
    provider                   String
    /// "SUBSCRIPTION_UPGRADE" | "CREDIT_TOPUP"
    type                       String    @default("SUBSCRIPTION_UPGRADE")
    targetTier                 String    @default("")
    termMonths                 Int       @default(1)
    discountPercent            Int       @default(0)
    amountETB                  Float
    /// credits granted (populated for CREDIT_TOPUP payments)
    creditsGranted             Int?
    verificationCreditsMonthly Int?
    imageCreditsMonthly        Int?
    planEndsAt                 DateTime?
    createdAt                  DateTime  @default(now())

    @@index([workspaceId])
}

model Announcement {
    id          String                @id @default(cuid())
    title       String?
    message     String                @db.Text
    ctaLabel    String?
    ctaHref     String?               @db.Text
    surface     AnnouncementSurface
    placement   AnnouncementPlacement
    active      Boolean               @default(true)
    dismissible Boolean               @default(true)
    priority    Int                   @default(0)
    startsAt    DateTime?
    endsAt      DateTime?
    createdAt   DateTime              @default(now())
    updatedAt   DateTime              @updatedAt

    @@index([surface, placement, active])
    @@index([startsAt])
    @@index([endsAt])
}

model BetaAccessRequest {
    id                String                  @id @default(cuid())
    workspaceId       String                  @unique
    workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    requestedByUserId String
    requestedBy       User                    @relation("BetaAccessRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)
    status            BetaAccessRequestStatus @default(PENDING)
    note              String?                 @db.Text
    reviewedByUserId  String?
    reviewedBy        User?                   @relation("BetaAccessReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
    reviewedAt        DateTime?
    decisionNote      String?                 @db.Text
    accessEndsAt      DateTime?
    createdAt         DateTime                @default(now())
    updatedAt         DateTime                @updatedAt

    @@index([status, createdAt])
    @@index([requestedByUserId])
    @@index([reviewedByUserId])
}

enum BetaAccessRequestStatus {
    PENDING
    APPROVED
    REJECTED
}

enum AnnouncementSurface {
    LANDING
    DASHBOARD
}

// One row per (workspace, provider, reference) this workspace has been shown a
// successful verification for.
//
// A receipt can be replayed: the same payer, receiver and amount arriving twice.
// Neither the recipient check nor the amount check can tell that apart from a
// legitimate second look-up — support re-checking after a customer query looks
// identical — so the fact is recorded and reported rather than refused. A caller
// that is about to grant something can refuse a repeat itself.
//
// firstSeenAt is never moved, so it stays the moment the receipt was first
// accepted. seenCount and lastSeenAt are diagnostics.
model VerifiedTransaction {
    id          String    @id @default(cuid())
    workspaceId String
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
    provider    String
    reference   String
    amount      Float?
    firstSeenAt DateTime  @default(now())
    lastSeenAt  DateTime  @default(now())
    seenCount   Int       @default(1)

    @@unique([workspaceId, provider, reference])
    @@index([workspaceId, lastSeenAt])
}

enum AnnouncementPlacement {
    STICKY_BANNER
    POPUP
    DASHBOARD_OVERVIEW
}
