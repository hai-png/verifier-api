# The build stage runs `COPY . .` (Dockerfile:63) AFTER `pnpm install`, so
# anything in the build context can overwrite the container's install. Without
# this file a local `node_modules` (pnpm symlink tree pointing at a global store)
# is copied over the image's, and the build fails with unresolved modules.

# Dependencies are installed inside the image from the lockfile.
node_modules/
**/node_modules/
.pnpm-store/

# Build output is regenerated by `pnpm build`.
dist/
web/.next/
web/out/
*.tsbuildinfo

# Never ship secrets or VCS/build metadata into the daemon or a remote builder.
.env
.env.*
!.env.example
.git/
.gitignore
.github/
.vscode/
.idea/

# Runtime artefacts, not inputs.
logs/
uploads/
coverage/

# Loadtest harness results: ~5 MB of generated reports and server logs that were
# previously tracked in git. See pnpm-workspace.yaml for the dependency notes
# that live alongside them.
loadtest-results/

# Docs and local agent state.
*.md
!README.md
!CHANGELOG.md
graphify-out/
.graphify*
*.patch
